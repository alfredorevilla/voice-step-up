<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>StepUp.Eval</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Evaluation tool, not shipped: Program sets the invariant culture, so interpolated report text cannot vary by locale. -->
    <NoWarn>$(NoWarn);CA1305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StepUp.Core\StepUp.Core.csproj" />
    <ProjectReference Include="..\..\src\StepUp.Verifier.Sherpa\StepUp.Verifier.Sherpa.csproj" />
  </ItemGroup>

</Project>
