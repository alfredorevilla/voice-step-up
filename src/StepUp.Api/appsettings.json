{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": { "Mode": "Entra" },
  "AzureAd": { "Instance": "https://login.microsoftonline.com/" },
  "Verifier": { "Mode": "Sherpa", "Sherpa": { "ModelsDir": "models", "Threads": 2, "MaxConcurrent": 2 } },
  "Storage": { "DatabasePath": "data/stepup.db", "KeyDirectory": "data/keys" },
  "Cors": { "AllowedOrigins": [ "http://localhost:5173" ] },
  "StepUp": { "ThresholdSeed": 0.80, "EnrollmentConsistencyFloor": 0.43 }
}
